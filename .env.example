PORT=4004
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_NAME=tocktest_db

# JWT (generate: openssl rand -base64 48)
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=24h

# GitHub PAT Encryption (AES-256-CBC, 64 hex chars = 32 bytes)
ENCRYPTION_KEY=ENCRYPTION_KEY

# AI API Center
AI_API_URL=http://localhost:3009

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4003

# GitHub App / Webhooks
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_URL=

# Background jobs (Postgres queue + in-process runner)
JOBS_ENABLED=true

# GitHub OAuth App (account-based connect flow)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4004/api/v1/github-tokens/oauth/callback
